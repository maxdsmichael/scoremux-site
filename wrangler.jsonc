      "pattern": "scoremux.com",
      "custom_domain": true
    },
    {
      "pattern": "www.scoremux.com",
      "custom_domain": true
    },
    {
      "pattern": "scoremux.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.scoremux.ai",
      "custom_domain": true
    },
    {
      "pattern": "scoremux.app",
      "custom_domain": true
    },
    {
      "pattern": "www.scoremux.app",
      "custom_domain": true
    }
  ]
}
